public class cugdan18
{
    // 18. Check duplicates
    public static void main(String[] args) {
        int[] arr = {3, 8, 2, 8, 5};
        boolean dup = false;

        for (int i = 0; i < arr.length; i++) {
            for (int j = i + 1; j < arr.length; j++) {
                if (arr[i] == arr[j]) dup = true;
            }
        }

        System.out.println("\nContains duplicate? " + dup);
    }
}
