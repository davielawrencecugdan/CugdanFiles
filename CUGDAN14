public class cugdan14
{
    // 14. Print reverse order
    public static void main(String[] args) {
        int[] arr = {1, 2, 3, 4, 5};

        System.out.println("\nReverse:");
        for (int i = arr.length - 1; i >= 0; i--) {
            System.out.print(arr[i] + " ");
        }
    }

}
