public class cugdan13
{
     // 13. Count pass/fail
    public static void main(String[] args) {
        int[] grades = {80, 65, 90, 72, 88};
        int pass = 0, fail = 0;

        for (int g : grades) {
            if (g >= 75) pass++;
            else fail++;
        }

        System.out.println("\nPass: " + pass + ", Fail: " + fail);
    }

}
