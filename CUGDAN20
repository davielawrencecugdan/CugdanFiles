public class cugdan20
{
    // 20. Print even numbers >20
    public static void main(String[] args) {
        int[] arr = {10, 22, 35, 48, 19, 60};

        System.out.println("\nEven numbers >20:");
        for (int n : arr) {
            if (n % 2 == 0 && n > 20) {
                System.out.print(n + " ");
            }
        }
    }
}
